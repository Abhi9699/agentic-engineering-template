            "additionalProperties": false
          },
          "contextBudget": {
            "type": "object",
            "description": "Per-spawn context cost ceiling in characters: the generated adapter body plus every preloaded SKILL.md. Enforced by scripts/agent-system/check-context-budget.mjs. Raising a ceiling is a deliberate, reviewable edit - which is the point.",
