{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.local/agent-system/manifest.schema.json",
  "title": "Autonomous agent control-plane manifests",
  "description": "Structural contract for every authored file in agent-system/. Structure only — cross-file semantics (reachability, ownership, acyclicity) are the repository validator's job, because JSON Schema cannot express them. See docs/archive/AGENTIC-ARCHITECTURE-EXCELLENCE-PLAN-2026-07-28.md §3.4.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable kebab-case identifier. Never reused after retirement."
    },
    "ruleRef": {
      "type": "string",
      "pattern": "^AGENTS-4-[0-9]+$",
      "description": "Reference to an AGENTS.md §4 rule by number. Policy prose is never copied here."
    },
    "decisionRef": {
      "type": "string",
      "pattern": "^(AD-[0-9]{2}|OQ-[0-9]+)$",
      "description": "Architecture decision (AD-nn) or binding product decision (OQ-n)."
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "completionState": {
      "enum": [
        "locally-verified",
        "handoff-ready",
        "PR-ready",
        "merge-ready",
        "deployed",
        "blocked"
      ]
    },
    "providerMapping": {
      "type": "string",
      "enum": [
        "native",
        "wrapper",
        "human-gated",
        "unsupported"
      ],
      "description": "How a provider satisfies a capability. `unsupported` fails closed for routes that require it."
    },
    "networkProfile": {
      "enum": [
        "none",
        "official-readonly",
        "public-readonly",
        "approved-external"
      ]
    },
    "boundedBudget": {
      "type": "object",
      "description": "Every dimension needs a positive finite maximum OR an explicit not_applicable with a reason. Implicit infinity, null, and magic zero are rejected (plan §3.5 loop law 11).",
      "oneOf": [
        {
          "properties": {
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "max"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "not_applicable": {
              "const": true
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          },
          "required": [
            "not_applicable",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "kind",
    "version"
  ],
  "properties": {
    "kind": {
      "enum": [
        "capabilities",
        "agents",
        "skills",
        "routing",
        "evidence",
        "sources",
        "budgets",
        "loops",
        "graph-contract",
        "providers",
        "completion-states",
        "decision-receipts",
        "hooks",
        "executive-roles",
        "controls",
        "frameworks"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "controls" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["source", "pillarPaths", "controls"],
        "properties": {
          "source": { "type": "string", "minLength": 5 },
          "pillarPaths": {
            "type": "object",
            "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "pillar", "title", "refs", "modes", "status", "phase", "mechanisms", "selfTest"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$" },
                "pillar": { "$ref": "#/$defs/id" },
                "title": { "type": "string", "minLength": 10 },
                "refs": { "type": "array", "items": { "type": "string", "minLength": 2 } },
                "modes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["block", "evidence", "runtime", "record", "judgment"] }
                },
                "status": { "enum": ["active", "partial", "planned"] },
                "phase": { "enum": ["now", "P0", "P1", "P2", "P3", "P4", "launch"] },
                "mechanisms": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(npm|rule|test|workflow|ruleset|hook|file|evidence|record):.+$" }
                },
                "selfTest": { "oneOf": [{ "type": "string", "minLength": 5 }, { "type": "null" }] },
                "reviewEveryDays": { "type": "integer", "minimum": 1 },
                "note": { "type": "string", "minLength": 5 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "frameworks" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["frameworks"],
        "properties": {
          "note": { "type": "string" },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "source", "retrieved", "items", "dispositions"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 5 },
                "source": { "type": "string", "format": "uri" },
                "retrieved": { "type": "string", "format": "date" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": { "id": { "type": "string", "minLength": 2 }, "title": { "type": "string", "minLength": 2 } },
                    "additionalProperties": false
                  }
                },
                "dispositions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["status", "reason"],
                    "properties": {
                      "status": { "enum": ["n/a", "inherited", "accepted-risk"] },
                      "reason": { "type": "string", "minLength": 15 },
                      "decision": { "type": "string", "pattern": "^OQ-[0-9]+$" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "executive-roles" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["roles", "officialSources"],
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "always", "stages", "framework", "citation", "requiredFields", "paths", "keywords", "ownerGates", "checklist"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z]{2,}$", "description": "One word: --check finds the role's section by a heading containing it." },
                "title": { "type": "string", "minLength": 3 },
                "always": { "type": "boolean" },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["spec", "gates", "review", "launch"] },
                  "description": "Where the role acts (doc 34 W10): spec = cited assessment before code; gates = what the machine enforces; review = checklist for the fresh reviewer; launch = R3+ release checklist."
                },
                "checklist": {
                  "type": "object",
                  "properties": {
                    "spec": { "type": "array", "items": { "type": "string", "minLength": 10 } },
                    "gates": { "type": "array", "items": { "type": "string", "minLength": 10 } },
                    "review": { "type": "array", "items": { "type": "string", "minLength": 10 } },
                    "launch": { "type": "array", "items": { "type": "string", "minLength": 10 } }
                  },
                  "additionalProperties": false
                },
                "framework": { "type": "string", "minLength": 10, "description": "The named external standard the role reviews against." },
                "citation": {
                  "type": "array",
                  "items": { "enum": ["dated-url", "file-line", "official-url", "money"] }
                },
                "requiredFields": { "type": "array", "items": { "type": "string", "minLength": 2 } },
                "paths": { "type": "array", "items": { "type": "string" } },
                "keywords": { "type": "array", "items": { "type": "string", "minLength": 2 } },
                "ownerGates": { "type": "array", "items": { "type": "string", "minLength": 5 } }
              },
              "additionalProperties": false
            }
          },
          "officialSources": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "capabilities"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description",
                "risk"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "description": {
                  "type": "string",
                  "minLength": 10
                },
                "risk": {
                  "$ref": "#/$defs/risk"
                },
                "networkProfile": {
                  "$ref": "#/$defs/networkProfile"
                },
                "humanGateRequired": {
                  "type": "boolean"
                },
                "humanOnly": {
                  "type": "boolean",
                  "description": "No agent holds this in a standing lane; it requires explicit per-instance human authorization. Exempt from the active-supplier invariant."
                }
              },
              "additionalProperties": false
            }
          },
          "mcpServers": {
            "type": "array",
            "description": "AGT-03: every MCP server a provider config in the repo names, with its scope and network profile. scripts/__tests__/mcp-allowlist.test.ts fails on one that is not listed.",
            "items": {
              "type": "object",
              "required": ["id", "providers", "endpoint", "scope", "networkProfile", "credential"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "providers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
                "endpoint": { "type": "string", "minLength": 3 },
                "scope": { "type": "string", "minLength": 10 },
                "networkProfile": { "$ref": "#/$defs/networkProfile" },
                "credential": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agents"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "agents"
        ],
        "properties": {
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "lane",
                "capabilities",
                "providers"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "lane": {
                  "type": "string",
                  "minLength": 10
                },
                "instructions": {
                  "type": "string",
                  "minLength": 100
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "exclusiveOwnership": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requiredSkills": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "conditionalSkills": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "providers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "readOnly": {
                  "type": "boolean"
                },
                "runtime": {
                  "enum": [
                    "main-session",
                    "built-in"
                  ],
                  "description": "Omitted: a generated subagent with adapters, instructions and a model tier. main-session: the session the user drives (doc 34 W5), which builds inline and gets no adapter. built-in: a subagent the provider ships (Claude Explore); nothing here is generated for it."
                },
                "status": {
                  "enum": [
                    "active",
                    "designed-not-added",
                    "retired"
                  ]
                },
                "trigger": {
                  "type": "string",
                  "description": "Required when status is designed-not-added: the observable event that justifies adding it."
                },
                "providerConfig": {
                  "type": "object",
                  "description": "Per-provider adapter settings. Generated files are emitted from this; hand-editing a generated region is caught by check-adapters.",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "type": "string",
                        "minLength": 20
                      },
                      "tools": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "disallowedTools": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "memory": {
                        "type": "string"
                      },
                      "omitClaudeMd": {
                        "type": "boolean",
                        "description": "Claude only: launch the subagent without the user, project and local CLAUDE.md (and the AGENTS.md it imports). For a role that takes everything from its delegation prompt. Source: https://code.claude.com/docs/en/sub-agents (verified 2026-10-03; Claude Code v2.1.271+)."
                      },
                      "maxTurns": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Claude only: the most agentic turns the subagent may take before it stops. Caps a review that would otherwise explore until its context is huge. Source: https://code.claude.com/docs/en/sub-agents (verified 2026-10-08)."
                      },
                      "model": {
                        "type": "string"
                      },
                      "sandboxMode": {
                        "type": "string"
                      },
                      "commandExecutionPolicy": {
                        "enum": [
                          "off",
                          "auto",
                          "eager",
                          "sandbox"
                        ],
                        "description": "Antigravity only: auto-execution policy for shell commands. Provider default is `sandbox`; we pin it explicitly so a future default change cannot silently loosen an agent. Source: https://antigravity.google/docs/subagents (verified 2026-09-02)."
                      },
                      "target": {
                        "type": "string"
                      },
                      "readOnly": {
                        "type": "boolean"
                      },
                      "userInvocable": {
                        "type": "boolean"
                      },
                      "disableModelInvocation": {
                        "type": "boolean"
                      },
                      "requiresSecretFreeWorktree": {
                        "type": "boolean"
                      },
                      "researchMode": {
                        "enum": [
                          "native-public-only",
                          "host-public-only",
                          "source-bundle-only"
                        ]
                      },
                      "connectorIsolation": {
                        "enum": [
                          "enforced",
                          "unsupported"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "skills"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "skills"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "provenance",
                "status"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "provenance": {
                  "enum": [
                    "tracked-first-party",
                    "lock-listed-external",
                    "provider-native",
                    "unregistered"
                  ],
                  "description": "Where the bytes come from. `provider-native` is a skill the PROVIDER ships (a Claude plugin or built-in): this repository cannot materialize, pin or verify it, and it does not exist on any provider outside `availableOn`."
                },
                "availableOn": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  },
                  "description": "Provider ids where this skill actually resolves. Omitted means every provider. Derived into each adapter's footer so an agent is never told to load something its provider does not have."
                },
                "mirrorOf": {
                  "type": "string",
                  "description": "For a discovery stub under .agents/skills/<id>/: the canonical skill directory it points at (e.g. `.claude/skills/<id>`). Enforced by scripts/agent-system/check-skill-mirrors.mjs - a mirror may not invent content the canonical lacks."
                },
                "status": {
                  "enum": [
                    "active",
                    "quarantined"
                  ]
                },
                "owner": {
                  "$ref": "#/$defs/id"
                },
                "source": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "networkProfile": {
                  "$ref": "#/$defs/networkProfile"
                },
                "selfTest": {
                  "type": "string"
                },
                "evidenceTypes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "hashVerifiable": {
                  "type": "boolean"
                },
                "quarantineReason": {
                  "type": "string"
                },
                "lastVerified": {
                  "type": "string",
                  "format": "date"
                },
                "integrity": {
                  "type": "object",
                  "required": [
                    "algorithm",
                    "hash"
                  ],
                  "properties": {
                    "algorithm": {
                      "type": "string"
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "fileCount": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "routing"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "routes"
        ],
        "properties": {
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "risk",
                "effect",
                "implementers",
                "evidence"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "triggers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "risk": {
                  "$ref": "#/$defs/risk"
                },
                "effect": {
                  "enum": [
                    "read-only",
                    "mutation"
                  ]
                },
                "lane": {
                  "enum": ["control-plane"],
                  "description": "Overrides the risk-derived exec:review lane. control-plane: an R3 route whose assessment is the CTO option record plus the pre-mortem, without the CPO market source or the release checklist."
                },
                "implementers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "verifiers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "advisors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "requiredSkills": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "humanGate": {
                  "type": "boolean"
                },
                "decisionRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/decisionRef"
                  }
                },
                "pillars": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evidence"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "evidenceTypes"
        ],
        "properties": {
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "producer",
                "description"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "description": {
                  "type": "string",
                  "minLength": 10
                },
                "producer": {
                  "type": "string",
                  "minLength": 3,
                  "description": "Executable command that emits it. Prose is never evidence."
                },
                "changedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "machineCheckable": {
                  "type": "boolean"
                },
                "reviewerRole": {
                  "$ref": "#/$defs/id"
                },
                "allowedActors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Who may sign this evidence besides a human; overrides the default of any known agent."
                },
                "phase": {
                  "enum": ["task", "pr"],
                  "description": "task (default): Stop checks it on the working tree. pr: owed once per branch, checked by pre-push (check-evidence --enforce --pr)."
                },
                "citedReview": {
                  "type": "boolean",
                  "description": "Recorded only by npm run review:check, after every cited file:line and quote is proved against the code."
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "loops"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "loops"
        ],
        "properties": {
          "loops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "controller",
                "state",
                "budgets",
                "stopConditions",
                "escalation",
                "rollback"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "controller": {
                  "type": "string",
                  "minLength": 3
                },
                "state": {
                  "enum": [
                    "shadow",
                    "warn",
                    "canary",
                    "block"
                  ]
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "actuators": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "budgets": {
                  "type": "object",
                  "required": [
                    "attempts",
                    "wallTimeMinutes",
                    "providerCostUsd"
                  ],
                  "properties": {
                    "attempts": {
                      "$ref": "#/$defs/boundedBudget"
                    },
                    "wallTimeMinutes": {
                      "$ref": "#/$defs/boundedBudget"
                    },
                    "providerCostUsd": {
                      "$ref": "#/$defs/boundedBudget"
                    }
                  },
                  "additionalProperties": false
                },
                "stopConditions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "escalation": {
                  "type": "string",
                  "minLength": 3
                },
