                  "minimum": 1
                }
              }
            },
            "additionalProperties": false
          },
          "complexity": {
            "type": "object",
            "description": "Doc 36 G1 complexity ratchet, enforced by scripts/agent-system/check-complexity-budget.mjs: npm scripts, lines under scripts/, and bytes every session loads at start. Growing one takes a commit carrying a `Budget-Raise:` trailer.",
            "required": [
