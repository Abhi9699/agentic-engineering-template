{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npm run gate)",
      "Bash(npm run gate:quick)",
      "Bash(npm run gate:quick *)",
      "Bash(npm run test:task)",
      "Bash(npm run test:task *)",
      "Bash(npm run exec:review *)",
      "PowerShell(npm run gate:quick:*)",
      "PowerShell(npm run test:task:*)",
      "PowerShell(npm run exec:review:*)",
      "PowerShell(npm run agent:scorecard:*)",
      "Bash(npm run check:rules)",
      "Bash(npm run db:check)",
      "Bash(npm run eval:prompts *)",
      "Bash(npm run eval:prompts)",
      "Bash(npm run webhook:simulate *)",
      "Bash(npm run webhook:simulate)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsx scripts/run-prompt-eval.ts *)",
      "Bash(npx drizzle-kit *)",
      "Bash(npx playwright *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git remote:*)",
      "Bash(git worktree:*)",
      "Bash(git restore:*)",
      "Bash(git describe:*)",
      "Bash(git push:*)",
      "Read(.claude/**)",
      "mcp__stitch__list_design_systems",
      "mcp__stitch__list_screens",
      "mcp__stitch__get_screen",
      "mcp__stitch__get_project",
      "mcp__stitch__generate_screen_from_text",
      "Bash(npm run check:*)",
      "Bash(npm run docs:*)",
      "Bash(npm run agent:*)",
      "Bash(npm run gen:configs *)",
      "Bash(npm run gen:configs)",
      "Bash(node scripts/generate-*)",
      "Bash(node scripts/check-vault.mjs)",
      "Bash(node scripts/agent-system/*)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -x:*)",
      "Bash(git clean -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "PowerShell(rm -rf /*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f:*)",
      "PowerShell(git filter-branch:*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "Edit(./lib/db/migrations/**)",
      "Read(**/service_account*.json)",
      "Edit(**/service_account*.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local*)",
      "Edit(**/.env.local*)",
      "Read(**/.env.production*)",
      "Edit(**/.env.production*)",
      "Read(**/.env.development*)",
      "Edit(**/.env.development*)",
      "Read(**/.env.preview*)",
      "Edit(**/.env.preview*)",
      "Read(**/.env.staging*)",
      "Edit(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Edit(**/.env.test*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "import(require('node:url').pathToFileURL(process.argv[1]).href).catch((e)=>{console.error(String(e)+' - failing closed');process.exit(2)})",
              "${CLAUDE_PROJECT_DIR}/scripts/hook-fail-closed.mjs",
              "guard-secrets.mjs"
            ],
            "if": "Bash(git commit *)",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "import(require('node:url').pathToFileURL(process.argv[1]).href).catch((e)=>{console.error(String(e)+' - failing closed');process.exit(2)})",
              "${CLAUDE_PROJECT_DIR}/scripts/hook-fail-closed.mjs",
              "guard-bash-secret-read.mjs"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "import(require('node:url').pathToFileURL(process.argv[1]).href).catch((e)=>{console.error(String(e)+' - failing closed');process.exit(2)})",
              "${CLAUDE_PROJECT_DIR}/scripts/hook-fail-closed.mjs",
              "guard-main-push.mjs"
            ],
            "if": "Bash(git push *)",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "import(require('node:url').pathToFileURL(process.argv[1]).href).catch((e)=>{console.error(String(e)+' - failing closed');process.exit(2)})",
              "${CLAUDE_PROJECT_DIR}/scripts/hook-fail-closed.mjs",
              "guard-bash-secret-read.mjs",
              "--powershell"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | grep -qF -e 'prompt-registry.ts' -e 'gemini.config.ts' -e 'lib/config/prompts/'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"PROMPT-LAYER EDIT - doc 16 s7 is binding: bump the prompt SemVer, run and RECORD the eval (3 fixed inputs x 5 platforms) before shipping, keep safety at BLOCK_MEDIUM_AND_ABOVE, and update docs 16/17 in the same change.\"}}'; fi",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/guard-agent-spend.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-system/hooks/claude-write-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-system/hooks/claude-prompt-preflight.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-system/hooks/claude-stop-guard.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "supabase@claude-plugins-official": true
  }
}
